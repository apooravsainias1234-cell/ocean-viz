# Copy this file to `.env` and fill in a value only if you need it -
# most setups (local dev, or opening the app from your phone on the same
# network) don't: src/api.js already auto-detects those cases.
#
# Set this when the frontend and backend are deployed to different
# hosts/domains (e.g. the frontend on Vercel/Netlify, the backend on
# Render/Fly/a VPS) - point it at wherever the FastAPI backend actually lives.
# VITE_API_BASE_URL=https://your-backend.example.com
